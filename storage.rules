rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /permisos/{empresa}/{pedidoId}/{fileName} {
      function isAuthorized() {
        return request.auth != null &&
          firestore.exists(/databases/(default)/documents/usuariosAutorizados/$(request.auth.token.email));
      }

      // request.resource solo existe en escrituras — separado de "read" para
      // no romper la lectura (request.resource.size sobre una request de
      // lectura evalúa a error y deniega todo, incluido el link "Ver").
      allow read: if isAuthorized();
      allow write: if isAuthorized() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/usuariosAutorizados/$(request.auth.token.email)).data.admin == true;
    }
  }
}
